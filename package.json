{
  "name": "accessrecheck",
  "version": "0.1.0",
  "private": true,
  "description": "Check website accessibility, record human review, and catch regressions before they ship.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "accessrecheck": "dist/cli.js",
    "arc": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raluonyiuke/accessrecheck.git"
  },
  "bugs": {
    "url": "https://github.com/raluonyiuke/accessrecheck/issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}

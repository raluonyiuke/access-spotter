{
  "name": "access-recheck",
  "version": "0.1.1",
  "private": true,
  "description": "Scan website accessibility at desktop and narrow widths, get fix guidance, and identify checks needing human review.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "access-recheck": "dist/cli.js",
    "arc": "dist/cli.js",
    "accessrecheck": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raluonyiuke/access-recheck.git"
  },
  "bugs": {
    "url": "https://github.com/raluonyiuke/access-recheck/issues"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "test:package": "node --test test/package/*.test.mjs",
    "setup": "node node_modules/playwright/cli.js install --no-shell chromium",
    "release:pack": "node scripts/release.mjs"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
